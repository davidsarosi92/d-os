      "muted": "#5d5d60",
      "accent": "#5980a6",
      "on_accent": "#ffffff",
      "hover": "#eef6ff",
      "press": "#d6ebff",
      "switch_off": "#b7b7ba",
      "knob": "#ffffff",
      "sel_bg": "#d6ebff",
      "sel_fg": "#1d1f20",
      "focus": { "rgb": "#5980a6", "alpha": 0.45 },
      "shadow_sm": { "dy": 1, "blur": 2, "rgb": "#2b2b2d", "alpha": 0.14 },
      "shadow_md": { "dy": 3, "blur": 10, "rgb": "#2b2b2d", "alpha": 0.16 },
      "shadow_lg": { "dy": 12, "blur": 32, "rgb": "#2b2b2d", "alpha": 0.22 }
    }
  },
  "density": {
    "comfort": { "control_h": 40, "control_pad_x": 18, "row_h": 40, "font_body": 15, "font_mono": 14 },
    "compact": { "control_h": 32, "control_pad_x": 14, "row_h": 32, "font_body": 14, "font_mono": 13 }
  },
  "geometry": {
    "border": 1,
    "radius_outer": 4,
    "radius_inner": 3,
    "checkbox": 20,
    "checkbox_radius": 4,
    "radio": 20,
    "radio_dot": 10,
    "switch_w": 48,
    "switch_h": 26,
    "switch_knob": 18,
    "switch_inset": 3,
    "switch_travel": 22,
    "slider_track_h": 6,
    "slider_thumb": 22,
    "progress_h": 8,
    "spinner": 20,
    "spinner_stroke": 2,
    "scrollbar_w": 12,
    "scrollbar_thumb_inset": 2,
    "scrollbar_thumb_min": 28,
    "titlebar_h": 38,
    "panel_h": 34,
    "taskbar_h": 46,
    "window_btn": 26,
    "menu_item_h": 34,
    "menu_pad": 6,
    "tab_h": 32,
    "tab_pad_x": 16,
    "tray_pad": 3,
    "table_header_h": 30,
    "focus_ring": 2,
    "focus_offset": 1,
    "min_touch_target": 44
  },
  "type": {
    "body": { "family": "Barlow", "weight": 400, "size_comfort": 15, "size_compact": 14, "line_height": 1.45 },
    "body_strong": { "family": "Barlow", "weight": 500 },
    "label": { "family": "Barlow Condensed", "weight": 600, "size": 11, "uppercase": true, "letter_spacing": 0.14 },
    "title": { "family": "Barlow Condensed", "weight": 600, "size": 22, "letter_spacing": 0.02 },
    "section": { "family": "Barlow Condensed", "weight": 600, "size": 26, "uppercase": true, "letter_spacing": 0.04 },
    "mono": { "family": "IBM Plex Mono", "weight": 400, "size_comfort": 14, "size_compact": 13, "use_for": "útvonalak, pid, méret, állapot, gyorsbillentyű, mérőszám" }
  },
  "motion": {
    "switch_knob_ms": 120,
    "theme_fade_ms": 140,
    "spinner_ms": 850,
    "indeterminate_ms": 1400,
    "easing": "linear (switch, spinner) / ease-in-out (indeterminate)"
  }
