{
  "name": "Console Plate",
  "version": "0.1",
  "note": "Logikai pixelek 1x skálán. HiDPI: minden hosszméretet egész számmal skálázz (2x, 3x), a színek változatlanok.",
  "themes": {
    "dark": {
