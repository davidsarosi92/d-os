      "sel_fg": "#eef6ff",
      "focus": { "rgb": "#94bce3", "alpha": 0.50 },
      "shadow_sm": { "dy": 1, "blur": 2, "rgb": "#000000", "alpha": 0.40 },
      "shadow_md": { "dy": 3, "blur": 10, "rgb": "#000000", "alpha": 0.42 },
      "shadow_lg": { "dy": 14, "blur": 34, "rgb": "#000000", "alpha": 0.55 }
